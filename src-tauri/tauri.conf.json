{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Job Radar",
  "version": "0.1.0",
  "identifier": "com.jobradar.app",
  "build": {
    "frontendDist": "../ui"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  }
}
